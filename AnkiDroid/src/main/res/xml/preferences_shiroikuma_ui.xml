<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the 白い熊 暗記 UI page — colour and font management for the app UI.
     A folding accordion: every top-level section is an SkSectionCategory keyed
     sk_sec_<section>, folded by default. The colour rows of a section (one per role
     of chrome/SkRoleTable) and the page's link, chip index and maintenance actions
     are added in code (ShiroikumaUiSettingsFragment.buildPage). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/shiroikuma_ui_title"
    android:key="@string/pref_shiroikuma_ui_screen_key">

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_eximport"
        android:title="@string/sk_section_eximport">
        <Preference
            android:key="@string/pref_sk_eximport_key"
            android:title="@string/sk_cat_eximport"
            android:summary="@string/sk_eim_row_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <SwitchPreferenceCompat
            android:key="@string/pref_sk_automation_enabled_key"
            android:title="@string/sk_automation_switch"
            android:summary="@string/sk_automation_switch_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <SwitchPreferenceCompat
            android:key="@string/pref_sk_automation_require_token_key"
            android:title="@string/sk_automation_require_token"
            android:summary="@string/sk_automation_require_token_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <com.ichi2.anki.shiroikuma.SecondaryActionPreference
            android:key="@string/pref_sk_automation_token_key"
            android:title="@string/sk_automation_token"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_foundation"
        android:title="@string/sk_section_foundation">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_text"
        android:title="@string/sk_section_text">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_buttons"
        android:title="@string/sk_section_buttons">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_dialogs"
        android:title="@string/sk_section_dialogs">
        <Preference
            android:title="@string/sk_sub_warnings"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <SwitchPreferenceCompat
            android:key="@string/pref_sk_webview_warning_key"
            android:defaultValue="true"
            android:title="@string/sk_webview_warning"
            android:summary="@string/sk_webview_warning_summary"
            android:layout="@layout/sk_preference_row"/>
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_switches"
        android:title="@string/sk_section_switches">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_marks"
        android:title="@string/sk_section_marks">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_menus"
        android:title="@string/sk_section_menus">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_lists"
        android:title="@string/sk_section_lists">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_fields"
        android:title="@string/sk_section_fields">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_bars"
        android:title="@string/sk_section_bars">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_drawer"
        android:title="@string/sk_section_drawer">
        <Preference
            android:title="@string/sk_sub_font"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <Preference
            android:key="@string/pref_sk_menu_font_key"
            android:title="@string/sk_menu_font"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <Preference
            android:key="@string/pref_sk_menu_font_reset_key"
            android:title="@string/sk_menu_font_reset"
            android:summary="@string/sk_menu_font_reset_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_menu_font_size_key"
            android:title="@string/sk_menu_font_size"
            android:defaultValue="14"
            android:valueFrom="10"
            android:valueTo="30"
            android:stepSize="1"
            app:displayFormat="@string/sk_format_sp"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_menu_font_weight_key"
            android:title="@string/sk_font_weight"
            android:summary="@string/sk_zero_default"
            android:defaultValue="0"
            android:valueFrom="0"
            android:valueTo="900"
            android:stepSize="100"
            app:displayFormat="@string/sk_format_plain"/>
        <Preference
            android:key="@string/pref_sk_menu_font_preview_key"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"
            android:selectable="false"/>
        <Preference
            android:title="@string/sk_sub_header"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <SwitchPreferenceCompat
            android:key="@string/pref_sk_menu_show_header_key"
            android:defaultValue="true"
            android:title="@string/sk_menu_show_header"
            android:summary="@string/sk_menu_show_header_summary"/>
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_deck"
        android:title="@string/sk_section_deck">
        <Preference
            android:title="@string/sk_sub_font"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <Preference
            android:key="@string/pref_sk_deck_font_key"
            android:title="@string/sk_menu_font"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <Preference
            android:key="@string/pref_sk_deck_font_reset_key"
            android:title="@string/sk_menu_font_reset"
            android:summary="@string/sk_menu_font_reset_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_deck_font_size_key"
            android:title="@string/sk_menu_font_size"
            android:summary="@string/sk_zero_default"
            android:defaultValue="0"
            android:valueFrom="0"
            android:valueTo="30"
            android:stepSize="1"
            app:displayFormat="@string/sk_format_sp"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_deck_font_weight_key"
            android:title="@string/sk_font_weight"
            android:summary="@string/sk_zero_default"
            android:defaultValue="0"
            android:valueFrom="0"
            android:valueTo="900"
            android:stepSize="100"
            app:displayFormat="@string/sk_format_plain"/>
        <Preference
            android:key="@string/pref_sk_deck_font_preview_key"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"
            android:selectable="false"/>
        <Preference
            android:title="@string/sk_sub_rows"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_deck_row_padding_key"
            android:title="@string/sk_deck_row_padding"
            android:summary="@string/sk_deck_row_padding_summary"
            android:defaultValue="12"
            android:valueFrom="0"
            android:valueTo="24"
            android:stepSize="1"
            app:displayFormat="@string/sk_format_dp"/>
        <Preference
            android:title="@string/sk_sub_pane_divider"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_pane_divider_width_key"
            android:title="@string/sk_pane_divider_width"
            android:defaultValue="1"
            android:valueFrom="0"
            android:valueTo="8"
            android:stepSize="1"
            app:displayFormat="@string/sk_format_dp"/>
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_study"
        android:title="@string/sk_section_study">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_browser"
        android:title="@string/sk_section_browser">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_settings"
        android:title="@string/sk_section_settings">
        <Preference
            android:title="@string/sk_sub_font"
            android:layout="@layout/sk_preference_subheader"
            android:selectable="false"
            android:persistent="false"/>
        <Preference
            android:key="@string/pref_sk_settings_font_key"
            android:title="@string/sk_menu_font"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <Preference
            android:key="@string/pref_sk_settings_font_reset_key"
            android:title="@string/sk_menu_font_reset"
            android:summary="@string/sk_menu_font_reset_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_settings_font_size_key"
            android:title="@string/sk_menu_font_size"
            android:summary="@string/sk_zero_default"
            android:defaultValue="0"
            android:valueFrom="0"
            android:valueTo="30"
            android:stepSize="1"
            app:displayFormat="@string/sk_format_sp"/>
        <com.ichi2.preferences.SliderPreference
            android:key="@string/pref_sk_settings_font_weight_key"
            android:title="@string/sk_font_weight"
            android:summary="@string/sk_zero_default"
            android:defaultValue="0"
            android:valueFrom="0"
            android:valueTo="900"
            android:stepSize="100"
            app:displayFormat="@string/sk_format_plain"/>
        <Preference
            android:key="@string/pref_sk_settings_font_preview_key"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"
            android:selectable="false"/>
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_sheets"
        android:title="@string/sk_section_sheets">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_pages"
        android:title="@string/sk_section_pages">
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>

    <com.ichi2.anki.shiroikuma.chrome.SkSectionCategory
        android:key="sk_sec_maintenance"
        android:title="@string/sk_section_maintenance">
        <Preference
            android:key="@string/pref_sk_reset_key"
            android:title="@string/sk_reset_all"
            android:summary="@string/sk_reset_all_summary"
            android:layout="@layout/sk_preference_row"
            android:persistent="false"/>
    </com.ichi2.anki.shiroikuma.chrome.SkSectionCategory>
</PreferenceScreen>
