<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the answer buttons of the older study screen, in place of upstream's footer_button_*
     shapes (named by answerButtonRef / answerButtonRippleRef in the theme overlay): an outlined
     pill, never filled. It stands in for an upstream shape, so it names role resources, which
     the palette feeds; the label keeps the colour of its answer. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sk_role_list_pressed">
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/sk_role_ease_ground" />
            <stroke
                android:width="1.25dp"
                android:color="@color/sk_role_pill_frame" />
        </shape>
    </item>
</ripple>
