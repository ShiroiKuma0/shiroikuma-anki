<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: kxkb-style section header for the 白い熊 暗記 UI page — a full-width
     1px hairline above the section, then a big bold title underlined only as
     wide as its text (the inner wrap_content wrapper shrinks to the TextView,
     making the match_parent underline text-wide). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#FFFFFF00"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="0dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF00"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="#FFFFFF00"/>
    </LinearLayout>
</LinearLayout>
